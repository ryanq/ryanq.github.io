---
import { getCollection } from 'astro:content'
import { kebabCase } from 'change-case'
import Page from '@layouts/Page.astro'

const df = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'America/New_York' })

const posts = await getCollection('blog')
---

<Page>
  <title slot="head">Writing</title>
  
  <main>
    <h1>Posts</h1>
    
    {posts.sort((a, b) => a.data.publish_date < b.data.publish_date ? 1 : -1).map(post => (
      <article>
        <h2><a href={`/posts/${post.data.slug ?? kebabCase(post.data.title)}`}>{post.data.title}</a></h2>
        <p>{df.format(post.data.publish_date)}</p>
      </article>
    ))}
  </main>
</Page>
  
<style>
  main {
    max-width: 70ch;
    margin: 0 auto;
    padding: 1rem;
  }

  h1 {
    font-size: 2rem;
  }
  
  article {
    display: flex;
    justify-content: space-between;
    margin-block: 1rem;
    font-size: 1rem;
  }
  
  h2 {
    font-size: 1.5rem;
  }
</style>
  